# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (Vercel → Storage → your database)
DATABASE_URL=

# GitHub OAuth app, for "Sign in with GitHub"
# https://github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The only GitHub account allowed into /admin
ADMIN_GITHUB_USERNAME=

# Optional but recommended: raises GitHub's API limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Production only (Vercel): protects /api/cron/refresh. Generate like BETTER_AUTH_SECRET.
CRON_SECRET=
